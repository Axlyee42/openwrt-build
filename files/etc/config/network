config interface 'loopback'
    option device 'lo'
    option proto 'static'
    option ipaddr '127.0.0.1'
    option netmask '255.0.0.0'


# ============================================================
# LAN Bridge
#
# eth2
# eth3
# eth4
# eth5
# ============================================================

config device
    option name 'br-lan'
    option type 'bridge'
    list ports 'eth2'
    list ports 'eth3'
    list ports 'eth4'
    list ports 'eth5'


# ============================================================
# LAN
# ============================================================

config interface 'lan'
    option device 'br-lan'
    option proto 'static'
    option ipaddr '__LAN_IP__'
    option netmask '255.255.255.0'
    option ip6assign '64'


# ============================================================
# WAN1
#
# eth0
# PPPoE
# IPv6
# ============================================================

config interface 'wan'
    option device 'eth0'
    option proto 'pppoe'
    option username '__WAN1_USER__'
    option password '__WAN1_PASS__'
    option ipv6 '1'


config interface 'wan6'
    option device '@wan'
    option proto 'dhcpv6'
    option reqaddress 'try'
    option reqprefix 'auto'


# ============================================================
# WAN2
#
# eth1
# PPPoE
# IPv6
# ============================================================

config interface 'wanb'
    option device 'eth1'
    option proto 'pppoe'
    option username '__WAN2_USER__'
    option password '__WAN2_PASS__'
    option ipv6 '1'


config interface 'wanb6'
    option device '@wanb'
    option proto 'dhcpv6'
    option reqaddress 'try'
    option reqprefix 'auto'
