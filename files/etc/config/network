config interface 'loopback'
    option device 'lo'
    option proto 'static'
    option ipaddr '127.0.0.1'
    option netmask '255.0.0.0'


config device
    option name 'br-lan'
    option type 'bridge'
    list ports 'eth2'
    list ports 'eth3'
    list ports 'eth4'
    list ports 'eth5'


config interface 'lan'
    option device 'br-lan'
    option proto 'static'
    option ipaddr '192.168.1.2'
    option netmask '255.255.255.0'
    option ip6assign '64'


# ==========================================================
# WAN1
# eth0
# PPPoE
# ==========================================================

config interface 'wan'
    option device 'eth0'
    option proto 'pppoe'
    option username 'WAN1_USERNAME'
    option password 'WAN1_PASSWORD'
    option ipv6 '1'


config interface 'wan6'
    option device '@wan'
    option proto 'dhcpv6'
    option reqaddress 'try'
    option reqprefix 'auto'


# ==========================================================
# WAN2
# eth1
# PPPoE
# ==========================================================

config interface 'wanb'
    option device 'eth1'
    option proto 'pppoe'
    option username 'WAN2_USERNAME'
    option password 'WAN2_PASSWORD'
    option ipv6 '1'


config interface 'wanb6'
    option device '@wanb'
    option proto 'dhcpv6'
    option reqaddress 'try'
    option reqprefix 'auto'
