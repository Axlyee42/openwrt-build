config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'


#
# Global IPv6 settings
#
config globals 'globals'


#
# LAN bridge
#
config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth2'
	list ports 'eth3'
	list ports 'eth4'
	list ports 'eth5'


#
# LAN
#
config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.2'
	option netmask '255.255.255.0'
	option ip6assign '64'


#
# WAN1
# eth0 -> PPPoE
#
config interface 'wan'
	option device 'eth0'
	option proto 'pppoe'
	option username 'a8736522'
	option password 'a123456'
	option ipv6 'auto'


#
# WAN1 IPv6
# Request IPv6 address + delegated prefix
#
config interface 'wan6'
	option device '@wan'
	option proto 'dhcpv6'
	option reqaddress 'try'
	option reqprefix 'auto'


#
# WAN2
# eth1 -> PPPoE
#
config interface 'wanb'
	option device 'eth1'
	option proto 'pppoe'
	option username '19908880017'
	option password 'a23456'
	option ipv6 'auto'


#
# WAN2 IPv6
# Request IPv6 address + delegated prefix
#
config interface 'wanb6'
	option device '@wanb'
	option proto 'dhcpv6'
	option reqaddress 'try'
	option reqprefix 'auto'
